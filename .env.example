# Generate a long random value for signing short-lived payment requests.
# Never commit the real secret.
PAYMENT_REQUEST_SECRET=replace-with-a-long-random-secret

# Optional in local development; required for durable production replay protection.
# Any PostgreSQL connection string works (for example Neon, Supabase, Railway, Render).
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
